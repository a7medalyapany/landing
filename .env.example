DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/landing
# Separate database for `pnpm test` — tests refuse to run without it. docker compose creates it.
TEST_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/landing_test
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Used by the github MCP server in .mcp.json. Export it in your shell profile;
# Claude Code expands it from the environment, not from this file.
# GITHUB_PERSONAL_ACCESS_TOKEN=
